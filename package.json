{
  "name": "weekender",
  "private": true,
  "description": "Budget trip planner for study-abroad students (GSB 5576 project)",
  "type": "module",
  "scripts": {
    "test": "node tests/run.mjs",
    "test:data": "node tests/data.test.mjs",
    "test:app": "node tests/app.test.mjs",
    "data": "node scripts/build-data.mjs && node scripts/embed-data.mjs",
    "pages": "node scripts/build-pages.mjs",
    "test:model": "node -e \"import('./tests/model.test.mjs').then(m=>process.exit(m.default()?1:0))\""
  },
  "devDependencies": {
    "d3": "7.9.0",
    "playwright": "1.63.0"
  }
}
